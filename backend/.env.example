# Application
NODE_ENV=development
PORT=3000
APP_NAME="Banduka POS"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3006

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banduka_pos?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=replace_with_a_64_plus_char_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_different_64_plus_char_random_secret
JWT_REFRESH_EXPIRES_IN=7d
RESET_PASSWORD_SECRET=replace_with_a_third_64_plus_char_random_secret
RESET_PASSWORD_EXPIRES_IN=15m

# eTIMS KRA Integration
ETIMS_API_URL=https://etims.kra.go.ke/etims-api/
ETIMS_ENVIRONMENT=sandbox
ETIMS_USERNAME=your_etims_username
ETIMS_PASSWORD=your_etims_password
ETIMS_TIN=your_tax_identification_number

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DESTINATION=./uploads

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@banduka.co.ke

# SMS (Optional - Africa's Talking)
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username

# Monitoring & Logging
LOG_LEVEL=debug
SENTRY_DSN=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Backup
BACKUP_RETENTION_DAYS=30
