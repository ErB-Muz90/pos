# ============================================================
# Bandu POS Backend — Production Environment Template
# Copy to .env and fill in all values before deploying.
# NEVER commit the filled .env to version control.
# ============================================================

NODE_ENV=production
PORT=3000
APP_NAME="Bandu POS"
APP_URL=https://api.yourdomain.com
# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://pos.yourdomain.com

# ── Database ─────────────────────────────────────────────────
# Use a managed Postgres (Supabase / Railway / RDS)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/banduka_pos?schema=public&sslmode=require

# ── Redis ────────────────────────────────────────────────────
# Use Upstash (free tier) or Railway Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ── JWT Secrets ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_BASE64
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_BASE64
JWT_REFRESH_EXPIRES_IN=7d
RESET_PASSWORD_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_BASE64
RESET_PASSWORD_EXPIRES_IN=15m

# ── eTIMS (KRA) ──────────────────────────────────────────────
ETIMS_API_URL=https://etims.kra.go.ke/etims-api/
ETIMS_ENVIRONMENT=production
ETIMS_USERNAME=your_etims_username
ETIMS_PASSWORD=your_etims_password
ETIMS_TIN=your_tax_identification_number

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# ── SMS ──────────────────────────────────────────────────────
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username

# ── Billing Webhooks ─────────────────────────────────────────
# Flutterwave: copy the "Secret Hash" from your FLW dashboard webhook settings
FLUTTERWAVE_SECRET_HASH=your_flutterwave_secret_hash
# Stripe: get from `stripe listen --print-secret` or Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Super Admin Seed (used once by scripts/seed-superadmin.ts) ───────────
SUPERADMIN_USERNAME=baundukasystems
SUPERADMIN_EMAIL=bandukasystems@gmail.com
SUPERADMIN_PASSWORD=BaundukaSystems123!

# ── Misc ─────────────────────────────────────────────────────
LOG_LEVEL=warn
ENABLE_SWAGGER=false
MAX_FILE_SIZE=5242880
UPLOAD_DESTINATION=./uploads
BACKUP_RETENTION_DAYS=30
